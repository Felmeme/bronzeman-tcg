<ul class="gallery mw-gallery-traditional">
		<li class="gallerybox" style="width: 215px">
			<div class="thumb" style="width: 210px; height: 150px;"><span typeof="mw:File"><a href="/w/File:Konar_preview.gif" class="mw-file-description" title="A first teaser of Konar quo Maten, created by Mod Gee"><img alt="A first teaser of Konar quo Maten, created by Mod Gee" src="/images/thumb/Konar_preview.gif/157px-Konar_preview.gif?1970f" decoding="async" loading="lazy" width="157" height="120" class="mw-file-element" srcset="/images/thumb/Konar_preview.gif/314px-Konar_preview.gif?1970f 2x" data-file-width="800" data-file-height="612" /></a></span></div>
