<ul><li><a href="/w/Karuulm_Slayer_Dungeon" title="Karuulm Slayer Dungeon">Karuulm Slayer Dungeon</a></li>
<li><a href="/w/Neypotzli" title="Neypotzli">Neypotzli</a></li>
<li><a href="/w/Charred_Dungeon" title="Charred Dungeon">Charred Dungeon</a></li></ul>
</td>
<td data-sort-value="125">125-190
</td>
<td>200-250
</td>
<td data-sort-value="6200"><span class="scp" data-skill="Slayer" data-level="62" style="position:relative;display:inline-block;height:1em;"><span class="mw-default-size" typeof="mw:File"><a href="/w/Slayer" title="Slayer"><img alt="Slayer" src="/images/Slayer_icon.png?cd34f" decoding="async" loading="lazy" width="23" height="24" class="mw-file-element" data-file-width="23" data-file-height="24" /></a></span> 62 </span>
</td>
<td>
<ul><li><a href="/w/Karuulm_Slayer_Dungeon" title="Karuulm Slayer Dungeon">Karuulm Slayer Dungeon</a>: <a href="/w/Wyrm" title="Wyrm">Wyrm</a></li>
<li><a href="/w/Neypotzli" title="Neypotzli">Neypotzli</a>: <a href="/w/Wyrmling" title="Wyrmling">Wyrmling</a></li>
<li><a href="/w/Charred_Dungeon" title="Charred Dungeon">Charred Dungeon</a>: <a href="/w/Lava_Strykewyrm" title="Lava Strykewyrm">Lava Strykewyrm</a></li></ul>
